<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MovieTitleStyle">
        <item name="android:textColor">@color/movie_gold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/montserrat</item>
    </style>

    <style name="MovieDetailsStyle">
        <item name="android:textColor">@color/movie_secondary_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/montserrat</item>
    </style>

    <style name="MovieRatingStyle" parent="MovieDetailsStyle">
        <item name="android:textColor">@color/movie_gold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
